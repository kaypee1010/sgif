/* ==================== MODULE 5 — EVENTS HUB ============================== */

/* ---- league_standings (NEW v1.7) ----------------------------------------
   Season-long standing across ALL event quizzes for a cohort.
   Only EVENT-mode rows counted — lecture/lab attempts excluded.
   ?cohort=SGT_LEAGUE_2025  (optional — returns all cohorts if omitted)
   ?top=10                  (default 10, max 50)
   Public — no api_key required.
   Returns per student:
     roll, name, section, eventsPlayed, formatsPlayed, avgPct,
     totalWeighted, scoreMax, bestGrade, lastSeen
------------------------------------------------------------------------- */
function handleLeagueStandings_(p) {
  var cohort = String(p.cohort || '').trim();
  var top    = Math.min(parseInt(p.top, 10) || 10, 50);

  var rows = readResponses_().filter(function (r) {
    var isEvent = String(r.mode || '').toUpperCase() === 'EVENT';
    if (!isEvent) return false;
    if (cohort && r.cohortId !== cohort) return false;
    return true;
  });
  if (!rows.length) return ok_([]);

  var map = {};
  rows.forEach(function (r) {
    if (!r.roll) return;
    if (!map[r.roll]) map[r.roll] = {
      roll: r.roll, name: r.name, section: r.section,
      quizzes: {}, formats: {}, pctSum: 0, attempts: 0,
      totalWeighted: 0, scoreMax: 0,
      bestPct: 0, bestGrade: 'F', lastSeen: null
    };
    var m = map[r.roll];
    m.attempts++;
    m.quizzes[r.quiz] = true;

    /* derive format brand from Quiz_ID prefix
       CC-01 → CC, APT-01 → APT, SHR-01 → SHR etc. */
    var brand = r.quiz.replace(/-\d+$/, '');
    m.formats[brand] = true;

    m.pctSum       += r.pct;
    m.totalWeighted+= (r.scoreWeighted || r.score || 0);
    m.scoreMax     += (r.scoreMax || r.total || 0);
    m.name          = r.name    || m.name;
    m.section       = r.section || m.section;

    if (r.pct > m.bestPct) {
      m.bestPct   = r.pct;
      m.bestGrade = r.grade || m.bestGrade;
    }
    if (r.ts && (!m.lastSeen || r.ts > m.lastSeen)) m.lastSeen = r.ts;
  });

  var list = Object.keys(map).map(function (k) {
    var m = map[k];
    var eventsPlayed  = Object.keys(m.quizzes).length;
    var formatsPlayed = Object.keys(m.formats).length;
    var avgPct        = Math.round(m.pctSum / m.attempts);
    var overallPct    = m.scoreMax > 0
      ? Math.round(100 * m.totalWeighted / m.scoreMax) : 0;
    return {
      roll:           m.roll,
      name:           m.name,
      section:        m.section,
      eventsPlayed:   eventsPlayed,
      formatsPlayed:  formatsPlayed,
      avgPct:         avgPct,
      overallPct:     overallPct,
      totalWeighted:  m.totalWeighted,
      scoreMax:       m.scoreMax,
      bestGrade:      m.bestGrade,
      lastSeen:       m.lastSeen ? m.lastSeen.toISOString() : ''
    };
  }).sort(function (a, b) {
    /* Primary: total weighted marks (rewards participation breadth)
       Secondary: overall pct (rewards quality)
       Tertiary: formats played (rewards diversity) */
    return (b.totalWeighted - a.totalWeighted)
        || (b.overallPct   - a.overallPct)
        || (b.formatsPlayed- a.formatsPlayed);
  }).slice(0, top);

  return ok_(list);
}


/* ==================== ONE-TIME SETUP ===================================== */
function setup() {
  getSheet_(SGIF.SHEETS.CONFIG,        ['Key','Value','Description','UpdatedOn']);
  getSheet_(SGIF.SHEETS.AUDIT,         ['Timestamp','Module','Action','Status','Remarks']);
  getSheet_(SGIF.SHEETS.RESPONSES,     RESPONSE_HEADERS_());
  getSheet_(SGIF.SHEETS.EVENTS,        EVENT_HEADERS_());
  getSheet_(SGIF.SHEETS.STUDENTS,      STUDENT_HEADERS_());
  getSheet_(SGIF.SHEETS.ACTIVITIES,    ACTIVITY_HEADERS_());
  getSheet_(SGIF.SHEETS.REGISTRATIONS, REGISTRATION_HEADERS_());

  var cfg = ss_().getSheetByName(SGIF.SHEETS.CONFIG);
  if (cfg.getLastRow() <= 1) {
    cfg.appendRow(['institution',             'SGT University', 'Shown in headers',                     new Date()]);
    cfg.appendRow(['faculty_name',            'K.P. Singh',     'Faculty owner',                        new Date()]);
    cfg.appendRow(['default_leaderboard_size','5',              'Top-N students',                       new Date()]);
    cfg.appendRow(['api_key',                 '',               'SET THIS — gates dashboard & exports', new Date()]);
  }
  logAudit_('Foundation','setup','OK','Tabs verified (v'+SGIF.VERSION+')');
  return 'SGIF setup complete (v'+SGIF.VERSION+'). All tabs verified. New: league_standings endpoint.';
}
