<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Learning Record — K.P. Singh · SGT University</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital,wght@0,400;1,400&family=DM+Sans:wght@400;500;600;700&family=Inconsolata:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --accent:      #2563eb;
  --accent-pale: #dbeafe;
  --accent-deep: #1d4ed8;
  --ink:         #1e293b;
  --ink-soft:    #64748b;
  --slate:       #475569;
  --paper:       #f8fafc;
  --cream:       #f1f5f9;
  --line:        #e2e8f0;
  --green:       #059669;
  --green-pale:  #ecfdf5;
  --rose:        #e11d48;
  --rose-pale:   #ffe4e6;
  --amber:       #b45309;
  --amber-pale:  #fef3c7;
  --violet:      #7c3aed;
  --violet-pale: #ede9fe;
  --mono:        'Inconsolata', monospace;
  --radius:      10px;
  --radius-lg:   14px;
  --shadow-sm:   0 1px 4px rgba(30,41,59,.07);
  --shadow-md:   0 4px 14px rgba(30,41,59,.09);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'DM Sans', sans-serif; font-size: 15.5px;
  line-height: 1.65; color: var(--ink);
  background: linear-gradient(150deg, var(--paper) 0%, #eef2f7 100%);
  min-height: 100vh;
}
body::before {
  content:''; position:fixed; inset:0; z-index:0; pointer-events:none;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.018'/%3E%3C/svg%3E");
  opacity:.4;
}
body::after {
  content:''; position:fixed; top:0; right:0; z-index:0; pointer-events:none;
  width:300px; height:300px;
  background:repeating-linear-gradient(45deg,var(--accent),var(--accent) 1px,transparent 1px,transparent 20px);
  opacity:.03;
}

/* NAV */
nav {
  position:fixed; top:0; left:0; right:0; z-index:100;
  background:rgba(248,250,252,.95); backdrop-filter:blur(12px);
  border-bottom:1px solid var(--line); padding:11px 26px;
  display:flex; align-items:center; justify-content:space-between;
}
.nav-brand { display:flex; align-items:center; gap:11px; }
.nav-logo {
  width:36px; height:36px; border-radius:50%;
  background:var(--accent); color:#fff;
  display:flex; align-items:center; justify-content:center;
  font-family:'DM Serif Display',serif; font-size:16px; flex-shrink:0;
}
.nav-name { font-family:'DM Serif Display',serif; font-size:15.5px; line-height:1.2; }
.nav-sub  { font-family:var(--mono); font-size:10px; letter-spacing:.05em; text-transform:uppercase; color:var(--ink-soft); }
.nav-links { display:flex; gap:8px; align-items:center; }
.nav-link {
  font-family:var(--mono); font-size:11px; font-weight:600;
  padding:7px 14px; border-radius:20px; text-decoration:none;
  border:1px solid var(--line); color:var(--ink-soft);
  transition:all .15s;
}
.nav-link:hover { border-color:var(--accent); color:var(--accent); }
.nav-link.primary { background:var(--accent); color:#fff; border-color:var(--accent); }
.nav-link.primary:hover { background:var(--accent-deep); }

/* MAIN */
main { position:relative; z-index:1; max-width:820px; margin:0 auto; padding:100px 22px 80px; }

/* PAGE HEAD */
.page-head { margin-bottom:30px; }
.eyebrow {
  font-family:var(--mono); font-size:10.5px; letter-spacing:.08em;
  text-transform:uppercase; color:var(--ink-soft); margin-bottom:5px;
}
h1 {
  font-family:'DM Serif Display',serif; font-weight:400;
  font-size:34px; line-height:1.15; margin-bottom:8px;
}
h1 em { font-style:italic; color:var(--accent); }
.lede { color:var(--ink-soft); font-size:14.5px; max-width:520px; }

/* LOOKUP BAR */
.lookup-card {
  background:#fff; border:1px solid var(--line); border-radius:var(--radius-lg);
  padding:24px 26px; margin-bottom:28px; box-shadow:var(--shadow-md);
  border-top:4px solid var(--accent);
}
.lookup-card h2 {
  font-family:'DM Serif Display',serif; font-size:19px; margin-bottom:14px;
}
.lookup-row { display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap; }
.lookup-field { flex:1; min-width:200px; }
.lookup-field label {
  display:block; font-family:var(--mono); font-size:10.5px;
  text-transform:uppercase; letter-spacing:.05em; color:var(--ink-soft);
  margin-bottom:6px;
}
.lookup-field input {
  width:100%; padding:11px 14px; border:1.5px solid var(--line);
  border-radius:8px; font-family:var(--mono); font-size:14px;
  text-transform:uppercase; letter-spacing:.04em; color:var(--ink);
  transition:border-color .15s, box-shadow .15s;
}
.lookup-field input:focus {
  outline:none; border-color:var(--accent);
  box-shadow:0 0 0 3px var(--accent-pale);
}
.lookup-btn {
  padding:11px 24px; background:var(--accent); color:#fff;
  border:none; border-radius:8px; font-family:'DM Sans',sans-serif;
  font-size:14px; font-weight:700; cursor:pointer; transition:background .15s;
  white-space:nowrap;
}
.lookup-btn:hover { background:var(--accent-deep); }
.lookup-btn:disabled { opacity:.5; cursor:not-allowed; }
.lookup-error {
  display:none; margin-top:12px; padding:10px 14px;
  background:var(--rose-pale); color:var(--rose);
  border-left:3px solid var(--rose); border-radius:6px; font-size:13px;
}
.lookup-error.show { display:block; }

/* PROFILE PANEL */
.profile-panel { display:none; }
.profile-panel.show { display:block; }

/* STUDENT HEADER */
.student-header {
  background:#fff; border:1px solid var(--line);
  border-radius:var(--radius-lg); padding:22px 26px;
  margin-bottom:20px; box-shadow:var(--shadow-sm);
  display:flex; gap:20px; align-items:center; flex-wrap:wrap;
}
.student-avatar {
  width:52px; height:52px; border-radius:50%;
  background:linear-gradient(135deg,var(--accent),var(--accent-deep));
  color:#fff; display:flex; align-items:center; justify-content:center;
  font-family:'DM Serif Display',serif; font-size:22px; flex-shrink:0;
}
.student-info { flex:1; }
.student-info .si-name {
  font-family:'DM Serif Display',serif; font-size:22px; line-height:1.2;
}
.student-info .si-meta {
  font-family:var(--mono); font-size:11.5px; color:var(--ink-soft); margin-top:3px;
}
.student-stats { display:flex; gap:16px; flex-wrap:wrap; }
.stat-chip {
  text-align:center; background:var(--cream); border-radius:var(--radius);
  padding:10px 16px; min-width:72px;
}
.stat-chip .sc-val {
  font-family:'DM Serif Display',serif; font-size:22px; line-height:1.1; color:var(--ink);
}
.stat-chip .sc-label {
  font-family:var(--mono); font-size:10px; text-transform:uppercase;
  letter-spacing:.05em; color:var(--ink-soft); margin-top:2px;
}

/* SECTION CARDS */
.section-card {
  background:#fff; border:1px solid var(--line);
  border-radius:var(--radius-lg); padding:22px 26px;
  margin-bottom:18px; box-shadow:var(--shadow-sm);
}
.section-card h3 {
  font-family:'DM Serif Display',serif; font-size:18px;
  margin-bottom:16px; display:flex; align-items:center; gap:8px;
}

/* ATTEMPTS TABLE */
.attempts-table { width:100%; border-collapse:collapse; font-size:13.5px; }
.attempts-table th {
  font-family:var(--mono); font-size:10px; text-transform:uppercase;
  letter-spacing:.06em; color:var(--ink-soft); padding:8px 10px;
  border-bottom:2px solid var(--line); text-align:left; font-weight:700;
}
.attempts-table td { padding:10px 10px; border-bottom:1px solid var(--line); }
.attempts-table tr:last-child td { border-bottom:none; }
.attempts-table tr:hover td { background:var(--cream); }
.grade-pill {
  font-family:var(--mono); font-size:11px; font-weight:700;
  padding:3px 10px; border-radius:10px; display:inline-block;
}
.grade-a-plus { background:#fef3c7; color:#92400e; }
.grade-a      { background:#dcfce7; color:#166534; }
.grade-b      { background:#dbeafe; color:#1e40af; }
.grade-c      { background:#f3e8ff; color:#6b21a8; }
.grade-d      { background:#fff7ed; color:#9a3412; }
.grade-e      { background:#fce7f3; color:#9d174d; }
.grade-f      { background:var(--rose-pale); color:var(--rose); }
.mode-pill {
  font-family:var(--mono); font-size:10px; font-weight:600;
  padding:2px 8px; border-radius:8px;
  background:var(--cream); color:var(--ink-soft); text-transform:uppercase;
}
.mode-pill.event { background:var(--amber-pale); color:var(--amber); }

/* TAG MASTERY */
.tag-row { margin-bottom:10px; }
.tag-row-head {
  display:flex; justify-content:space-between; align-items:center;
  margin-bottom:4px;
}
.tag-name {
  font-family:var(--mono); font-size:12px; font-weight:600; color:var(--ink);
}
.tag-pct  {
  font-family:var(--mono); font-size:12px; font-weight:700;
}
.tag-bar-wrap {
  height:7px; background:var(--line); border-radius:4px; overflow:hidden;
}
.tag-bar-fill {
  height:100%; border-radius:4px; transition:width .5s ease;
}

/* CALIBRATION */
.calib-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:14px; }
@media(max-width:500px) { .calib-grid { grid-template-columns:1fr 1fr; } }
.calib-cell {
  background:var(--cream); border-radius:var(--radius);
  padding:14px; text-align:center;
}
.calib-cell .cc-val {
  font-family:'DM Serif Display',serif; font-size:28px; line-height:1.1;
}
.calib-cell .cc-label {
  font-family:var(--mono); font-size:10px; text-transform:uppercase;
  letter-spacing:.05em; color:var(--ink-soft); margin-top:3px; line-height:1.4;
}
.calib-note {
  padding:12px 14px; border-radius:8px; font-size:13.5px; line-height:1.55;
  background:var(--amber-pale); color:var(--amber);
  border-left:3px solid var(--amber);
}

/* PASSPORT TEASER */
.passport-teaser-card {
  background:linear-gradient(135deg,var(--violet-pale),#f8f4ff);
  border:1px solid #c4b5fd; border-radius:var(--radius-lg);
  padding:22px 26px; margin-bottom:18px;
  display:flex; align-items:center; gap:16px; flex-wrap:wrap;
}
.pt-icon { font-size:36px; flex-shrink:0; }
.pt-text .pt-title {
  font-family:'DM Serif Display',serif; font-size:18px;
  color:var(--violet); margin-bottom:4px;
}
.pt-text .pt-desc { font-size:13.5px; color:var(--slate); }

/* LOADING */
.spinner {
  width:32px; height:32px; border:3px solid var(--line);
  border-top-color:var(--accent); border-radius:50%;
  animation:spin .8s linear infinite; margin:28px auto;
}
@keyframes spin { to { transform:rotate(360deg); } }
.empty-state {
  padding:32px; text-align:center; color:var(--ink-soft); font-size:14px;
}

/* RESPONSIVE */
@media(max-width:560px) {
  main { padding-top:92px; }
  h1   { font-size:26px; }
  .nav-links .nav-link:not(.primary) { display:none; }
  .student-stats { gap:10px; }
  .attempts-table th:nth-child(4),
  .attempts-table td:nth-child(4) { display:none; }
}
</style>
</head>
<body>

<nav>
  <div class="nav-brand">
    <div class="nav-logo">KP</div>
    <div>
      <div class="nav-name">K.P. Singh</div>
      <div class="nav-sub">SGT University · Student Portal</div>
    </div>
  </div>
  <div class="nav-links">
    <a class="nav-link" href="student_registration.html">🏆 Events</a>
    <a class="nav-link primary" href="https://kpsingh.in" target="_blank" rel="noopener">kpsingh.in ↗</a>
  </div>
</nav>

<main>

  <div class="page-head">
    <div class="eyebrow">Student Growth Intelligence · SGIF</div>
    <h1>My <em>Learning Record</em></h1>
    <p class="lede">Enter your roll number to see all your quiz attempts, topic mastery, and confidence calibration across every lecture, lab, and event quiz.</p>
  </div>

  <!-- LOOKUP -->
  <div class="lookup-card">
    <h2>Look up your record</h2>
    <div class="lookup-row">
      <div class="lookup-field">
        <label for="roll-input">Roll Number</label>
        <input id="roll-input" placeholder="E.G. 241302001"
               onkeydown="if(event.key==='Enter') lookup()">
      </div>
      <button class="lookup-btn" id="lookup-btn" onclick="lookup()">View my record →</button>
    </div>
    <div class="lookup-error" id="lookup-error"></div>
  </div>

  <!-- PROFILE -->
  <div class="profile-panel" id="profile-panel">

    <!-- student header -->
    <div class="student-header" id="student-header"></div>

    <!-- passport teaser -->
    <div class="passport-teaser-card">
      <div class="pt-icon">🎓</div>
      <div class="pt-text">
        <div class="pt-title">Your Growth Passport is being built</div>
        <div class="pt-desc">As you take more quizzes, your passport will show your learning trajectory, topic mastery trends, and confidence calibration — all in one place. Every quiz you take adds to it.</div>
      </div>
    </div>

    <!-- attempts -->
    <div class="section-card">
      <h3>📋 All Attempts</h3>
      <div id="attempts-wrap"></div>
    </div>

    <!-- tag mastery -->
    <div class="section-card">
      <h3>🎯 Topic Mastery</h3>
      <div id="tags-wrap"></div>
    </div>

    <!-- calibration -->
    <div class="section-card" id="calib-card" style="display:none;">
      <h3>🔬 Confidence Calibration</h3>
      <div id="calib-wrap"></div>
    </div>

  </div>

</main>

<script>
/* ============================================================
   SGIF STUDENT PORTAL — student.html
   Roll-number-only lookup. No Submission ID required.
   Calls: ?action=student_lookup&roll=...
   ============================================================ */
const API_URL = 'PASTE_YOUR_FOUNDATION_EXEC_URL_HERE';

async function apiGet(params) {
  const qs  = Object.entries(params).map(([k,v]) => k+'='+encodeURIComponent(v)).join('&');
  const url = API_URL + (API_URL.includes('?') ? '&' : '?') + qs;
  const res = await fetch(url);
  const j   = await res.json();
  if (!j.success) throw new Error(j.message || 'Request failed');
  return j.data;
}

async function lookup() {
  const roll  = document.getElementById('roll-input').value.trim().toUpperCase();
  const errEl = document.getElementById('lookup-error');
  const btn   = document.getElementById('lookup-btn');
  errEl.classList.remove('show');

  if (!roll) { errEl.textContent='Please enter your roll number.'; errEl.classList.add('show'); return; }

  btn.disabled = true; btn.textContent = 'Loading…';

  try {
    const data = await apiGet({ action:'student_lookup', roll });
    renderProfile(data);
    document.getElementById('profile-panel').classList.add('show');
    document.getElementById('profile-panel').scrollIntoView({ behavior:'smooth', block:'start' });
  } catch(e) {
    errEl.textContent = e.message.includes('No attempts')
      ? 'No quiz attempts found for roll number ' + roll + '. Have you taken a quiz yet?'
      : e.message;
    errEl.classList.add('show');
    document.getElementById('profile-panel').classList.remove('show');
  } finally {
    btn.disabled = false; btn.textContent = 'View my record →';
  }
}

function renderProfile(d) {
  /* ── student header ── */
  const initials = (d.name||'?').split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
  document.getElementById('student-header').innerHTML = `
    <div class="student-avatar">${esc(initials)}</div>
    <div class="student-info">
      <div class="si-name">${esc(d.name)}</div>
      <div class="si-meta">${esc(d.roll)}${d.branch?' · '+esc(d.branch):''}${d.semester?' · Sem '+esc(d.semester):''}${d.section?' · Sec '+esc(d.section):''}</div>
    </div>
    <div class="student-stats">
      <div class="stat-chip">
        <div class="sc-val">${d.quizzesTaken}</div>
        <div class="sc-label">Quizzes</div>
      </div>
      <div class="stat-chip">
        <div class="sc-val">${d.avgPct}%</div>
        <div class="sc-label">Avg score</div>
      </div>
      <div class="stat-chip">
        <div class="sc-val">${d.bestGrade}</div>
        <div class="sc-label">Best grade</div>
      </div>
      <div class="stat-chip">
        <div class="sc-val">${d.attemptsCount}</div>
        <div class="sc-label">Attempts</div>
      </div>
    </div>`;

  /* ── attempts table ── */
  const attWrap = document.getElementById('attempts-wrap');
  if (!d.attempts || !d.attempts.length) {
    attWrap.innerHTML = '<div class="empty-state">No attempts yet.</div>'; 
  } else {
    const rows = [...d.attempts].reverse().map(a => {
      const date = a.date ? new Date(a.date).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) : '—';
      const score = a.scoreWeighted !== undefined && a.scoreWeighted !== a.score
        ? `${a.scoreWeighted}<small style="color:var(--ink-soft)">/${a.scoreMax}</small> <small style="color:var(--ink-soft)">(${a.score} raw)</small>`
        : `${a.score}<small style="color:var(--ink-soft)">/${a.total||a.scoreMax}</small>`;
      return `<tr>
        <td><b>${esc(a.quiz)}</b>${a.cohortId?'<br><small style="color:var(--ink-soft);font-family:var(--mono);font-size:10px">'+esc(a.cohortId)+'</small>':''}</td>
        <td>${date}</td>
        <td>${score}</td>
        <td>${a.pct}%</td>
        <td><span class="grade-pill grade-${(a.grade||'f').toLowerCase().replace('+','-plus')}">${esc(a.grade)}</span></td>
        <td><span class="mode-pill ${a.mode==='EVENT'?'event':''}">${esc(a.mode||'LECTURE')}</span></td>
        <td style="font-family:var(--mono);font-size:12px;color:var(--ink-soft)">${esc(a.timeTaken||'—')}</td>
      </tr>`;
    }).join('');
    attWrap.innerHTML = `
      <table class="attempts-table">
        <thead><tr>
          <th>Quiz</th><th>Date</th><th>Score</th><th>%</th><th>Grade</th><th>Mode</th><th>Time</th>
        </tr></thead>
        <tbody>${rows}</tbody>
      </table>`;
  }

  /* ── tag mastery ── */
  const tagWrap = document.getElementById('tags-wrap');
  if (!d.topics || !d.topics.length) {
    tagWrap.innerHTML = '<div class="empty-state">No topic data yet — take a quiz to see your mastery map.</div>';
  } else {
    const sorted = [...d.topics].sort((a,b) => a.pct - b.pct); // weakest first
    tagWrap.innerHTML = sorted.map(t => {
      const color = t.pct >= 75 ? 'var(--green)'
        : t.pct >= 50 ? 'var(--accent)'
        : t.pct >= 30 ? 'var(--amber)'
        : 'var(--rose)';
      const label = t.pct >= 75 ? '✓ Strong' : t.pct >= 50 ? '→ Developing' : t.pct >= 30 ? '⚠ Needs work' : '✗ Weak spot';
      return `<div class="tag-row">
        <div class="tag-row-head">
          <span class="tag-name">${esc(t.tag)}</span>
          <span class="tag-pct" style="color:${color}">${t.pct}% <small style="font-weight:400;color:var(--ink-soft)">(${t.correct}/${t.total}) ${label}</small></span>
        </div>
        <div class="tag-bar-wrap">
          <div class="tag-bar-fill" style="width:${t.pct}%;background:${color}"></div>
        </div>
      </div>`;
    }).join('');
  }

  /* ── calibration ── */
  const calib = d.calibration;
  if (calib && calib.itemsRated > 0) {
    document.getElementById('calib-card').style.display = '';
    let note = '';
    if (calib.overconfidentItems > 0 && calib.underconfidentItems === 0) {
      note = `You marked yourself <b>Very Sure</b> but got <b>${calib.overconfidentItems}</b> question${calib.overconfidentItems>1?'s':''} wrong. These are your most valuable study targets — the gaps you don't know you have.`;
    } else if (calib.underconfidentItems > 0 && calib.overconfidentItems === 0) {
      note = `You got <b>${calib.underconfidentItems}</b> question${calib.underconfidentItems>1?'s':''} right despite rating yourself as Not Sure. Trust your knowledge more — you know more than you think.`;
    } else if (calib.overconfidentItems > 0) {
      note = `<b>${calib.overconfidentItems}</b> overconfident mistake${calib.overconfidentItems>1?'s':''} and <b>${calib.underconfidentItems}</b> hidden strength${calib.underconfidentItems>1?'s':''}. Focus revision on the topics where you felt sure but weren't.`;
    } else {
      note = `Well calibrated! Your confidence ratings closely match your actual accuracy. Average confidence: ${calib.avgConfidencePct}%.`;
    }
    document.getElementById('calib-wrap').innerHTML = `
      <div class="calib-grid">
        <div class="calib-cell">
          <div class="cc-val" style="color:var(--ink-soft)">${calib.itemsRated}</div>
          <div class="cc-label">Questions rated</div>
        </div>
        <div class="calib-cell">
          <div class="cc-val" style="color:var(--rose)">${calib.overconfidentItems}</div>
          <div class="cc-label">Very Sure but Wrong</div>
        </div>
        <div class="calib-cell">
          <div class="cc-val" style="color:var(--violet)">${calib.underconfidentItems}</div>
          <div class="cc-label">Unsure but Correct</div>
        </div>
      </div>
      <div class="calib-note">${note}</div>`;
  }
}

function esc(s) {
  return String(s==null?'':s).replace(/[&<>"']/g, m =>
    ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}
</script>
</body>
</html>
