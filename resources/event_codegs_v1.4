/* ============================================================================
   SGIF PLATFORM — Apps Script Backend (Code.gs)  v1.5.0
   Modules:  1 Foundation · 2 Student · 3 Activities & Registration
   ----------------------------------------------------------------------------
   WHAT CHANGED IN v1.5  (everything else is identical to v1.4)
   ─────────────────────────────────────────────────────────────────────────────
   1. REGISTRATION_HEADERS_()
      Four new columns added after 'Branch':
        Email · Phone · Course · Specialisation
      Total columns: 14  (was 10)

   2. handleRegister_()
      • Reads p.email, p.phone, p.course, p.specialisation from GET params
      • Writes them into the four new columns in appendRow
      • Validation: email and phone are accepted if provided; not enforced
        server-side (client already validates) but stored as-is

   3. handleMyRegistrations_()
      • Returns email, phone, course, specialisation in each registration
        object so passport.html can pre-fill fields later

   4. handleParticipants_()
      • Returns the four new fields in the participant list for faculty export

   5. setup()
      • Bumped version string; no structural change needed — getSheet_() will
        add missing columns automatically on first appendRow only if the sheet
        is EMPTY. If your Registrations sheet already has data, manually insert
        the four new column headers after 'Branch' in row 1:
          Email | Phone | Course | Specialisation
        then re-deploy this script as a new version.

   DEPLOY CHECKLIST
   ─────────────────
   □ Paste this entire file into your Apps Script editor (replace Code.gs)
   □ In the Registrations sheet, insert these 4 headers after 'Branch' in row 1:
       Email  |  Phone  |  Course  |  Specialisation
     (only needed if the sheet already has data rows)
   □ Deploy → Manage deployments → New version → Deploy
   □ The /exec URL does NOT change — no update needed in events.html or quiz files
   ============================================================================ */

const SGIF = {
  SHEETS: {
    CONFIG:        'Config',
    AUDIT:         'Audit',
    RESPONSES:     'Responses',
    EVENTS:        'Events',
    STUDENTS:      'Students',
    ACTIVITIES:    'Activities',
    REGISTRATIONS: 'Registrations'
  },
  VERSION: '1.5.0'   // ← bumped
};


/* ============================ ROUTERS ==================================== */

function doPost(e) {
  try {
    var data = {};
    if (e && e.postData && e.postData.contents) data = JSON.parse(e.postData.contents);
    var action = String(data.action || 'quiz_response').toLowerCase();

    switch (action) {
      case 'quiz_response':
      case 'response':       return handleQuizResponse_(data);
      case 'events':         return handleEvents_(data);
      case 'ping':           return ok_({ pong: true, version: SGIF.VERSION });
      default:               return fail_('ERR-004', 'Unknown action: ' + action);
    }
  } catch (err) {
    logAudit_('Foundation', 'doPost', 'ERROR', String(err));
    return fail_('ERR-009', String(err));
  }
}

function doGet(e) {
  try {
    var p = (e && e.parameter) ? e.parameter : {};
    var action = String(p.action || '').toLowerCase();

    switch (action) {
      case '':
      case 'ping':                return ok_({ message: 'SGIF API live.', version: SGIF.VERSION });
      case 'leaderboard':         return handleLeaderboard_(p);
      case 'quizzes':             return handleQuizList_();
      case 'config':              return ok_(getAllConfig_());
      case 'student_profile':     return handleStudentProfile_(p);
      case 'students':            return handleStudentsList_(p);
      /* ---- Module 3 ---- */
      case 'activities':          return handleActivities_(p);
      case 'register':            return handleRegister_(p);
      case 'my_registrations':    return handleMyRegistrations_(p);
      case 'cancel_registration': return handleCancelRegistration_(p);
      case 'participants':        return handleParticipants_(p);
      default:                    return fail_('ERR-004', 'Unknown action: ' + action);
    }
  } catch (err) {
    logAudit_('Foundation', 'doGet', 'ERROR', String(err));
    return fail_('ERR-009', String(err));
  }
}


/* ==================== MODULE 1 — WRITE HANDLERS ========================== */

function handleQuizResponse_(d) {
  var sh = getSheet_(SGIF.SHEETS.RESPONSES, RESPONSE_HEADERS_());

  var tags     = firstNonEmpty_(collectIndexed_(d, 'tag_'),     d.tags);
  var confs    = firstNonEmpty_(collectIndexed_(d, 'conf_'),    d.confidence);
  var corrects = firstNonEmpty_(collectIndexed_(d, 'correct_'), d.correct);
  var scoreRaw = (d.score !== undefined) ? d.score : d.scoreRaw;

  sh.appendRow([
    new Date(), safe_(d.submissionId), safe_(d.sessionId),
    safe_(d.quizType || d.quizId), safe_(d.cohortId),
    safe_(d.name), safe_(d.roll), safe_(d.section), safe_(d.branch), safe_(d.semester),
    safe_(d.mode || 'LECTURE'),
    numOr_(scoreRaw, ''), numOr_(d.scoreWeighted, numOr_(scoreRaw, '')),
    numOr_(d.total, ''), numOr_(d.scoreMax, numOr_(d.total, '')),
    numOr_(d.percentage, ''), safe_(d.grade), safe_(d.passed),
    safe_(d.timeTaken), safe_(d.submittedAt),
    JSON.stringify(d.sectionScores || []), JSON.stringify(d.difficultyScores || {}),
    JSON.stringify(tags), JSON.stringify(confs), JSON.stringify(corrects)
  ]);

  logAudit_('Quiz', 'quiz_response', 'OK', safe_(d.roll) + ' / ' + safe_(d.quizType || d.quizId));
  return ok_({ stored: true });
}

function handleEvents_(d) {
  var sh = getSheet_(SGIF.SHEETS.EVENTS, EVENT_HEADERS_());
  var events = (d && d.events) ? d.events : [];
  if (!events.length) return ok_({ received: 0 });

  var rows = events.map(function (ev) {
    return [ new Date(), safe_(ev.sessionId), numOr_(ev.eventId, ''), safe_(ev.quizId),
             safe_(ev.studentId), safe_(ev.questionId), safe_(ev.eventType),
             safe_(ev.eventValue), safe_(ev.clientTs), numOr_(ev.elapsedMs, '') ];
  });
  sh.getRange(sh.getLastRow() + 1, 1, rows.length, rows[0].length).setValues(rows);
  return ok_({ received: rows.length });
}


/* ==================== MODULE 1 — READ HANDLERS =========================== */

function handleLeaderboard_(p) {
  var top = parseInt(p.top, 10) || 5;
  var quiz = String(p.quiz || '').toLowerCase();
  var rows = readResponses_();
  if (!rows.length) return ok_([]);

  var best = {};
  rows.forEach(function (r) {
    if (quiz && String(r.quiz).toLowerCase().indexOf(quiz) === -1) return;
    if (!r.roll) return;
    if (!best[r.roll] || r.pct > best[r.roll].pct) {
      best[r.roll] = { name: r.name, roll: r.roll, section: r.section,
                       score: r.score, total: r.total, pct: r.pct, grade: r.grade };
    }
  });
  var sorted = Object.keys(best).map(function (k) { return best[k]; })
    .sort(function (a, b) { return (b.pct - a.pct) || (b.score - a.score); }).slice(0, top);
  return ok_(sorted);
}

function handleQuizList_() {
  var rows = readResponses_();
  if (!rows.length) return ok_([]);
  var map = {};
  rows.forEach(function (r) {
    if (!r.quiz) return;
    if (!map[r.quiz]) map[r.quiz] = { quiz: r.quiz, attempts: 0, lastSeen: null };
    map[r.quiz].attempts++;
    if (r.ts && (!map[r.quiz].lastSeen || r.ts > map[r.quiz].lastSeen)) map[r.quiz].lastSeen = r.ts;
  });
  var list = Object.keys(map).map(function (k) {
    var o = map[k];
    return { quiz: o.quiz, attempts: o.attempts, lastSeen: o.lastSeen ? o.lastSeen.toISOString() : '' };
  }).sort(function (a, b) { return (b.lastSeen > a.lastSeen) ? 1 : -1; });
  return ok_(list);
}


/* ==================== MODULE 2 — STUDENT HANDLERS ======================== */

function handleStudentProfile_(p) {
  var roll = String(p.roll || '').trim().toUpperCase();
  var sid  = String(p.sid  || '').trim().toUpperCase();
  if (!roll || !sid) return fail_('ERR-001', 'roll and sid are both required.');

  var rows = readResponses_().filter(function (r) { return r.roll === roll; });
  if (!rows.length) return fail_('ERR-004', 'No attempts found for that roll number.');

  var owns = rows.some(function (r) { return String(r.submissionId || '').toUpperCase() === sid; });
  if (!owns) {
    logAudit_('Student', 'student_profile', 'DENIED', roll);
    return fail_('ERR-003', 'That Submission ID does not belong to this roll number.');
  }

  var roster = lookupRoster_(roll);
  rows.sort(function (a, b) { return a.ts - b.ts; });
  var attempts = rows.map(function (r) {
    return { quiz: r.quiz, date: r.ts ? r.ts.toISOString() : '', mode: r.mode,
             score: r.score, total: r.total, pct: r.pct, grade: r.grade };
  });

  var tagStats = {};
  var calib = { rated: 0, sureWrong: 0, unsureRight: 0, confSum: 0 };
  rows.forEach(function (r) {
    var tags = parseArr_(r.tagsJson), corr = parseArr_(r.correctJson), conf = parseArr_(r.confJson);
    for (var i = 0; i < tags.length; i++) {
      var tg = tags[i]; if (!tg) continue;
      if (!tagStats[tg]) tagStats[tg] = { c: 0, t: 0 };
      tagStats[tg].t++;
      var isRight = Number(corr[i]) === 1;
      if (isRight) tagStats[tg].c++;
      var cv = Number(conf[i]) || 0;
      if (cv > 0) {
        calib.rated++; calib.confSum += cv;
        if (cv === 3 && !isRight) calib.sureWrong++;
        if (cv === 1 &&  isRight) calib.unsureRight++;
      }
    }
  });
  var topics = Object.keys(tagStats).map(function (t) {
    return { tag: t, correct: tagStats[t].c, total: tagStats[t].t,
             pct: Math.round(100 * tagStats[t].c / tagStats[t].t) };
  }).sort(function (a, b) { return a.pct - b.pct; });

  var avgPct = Math.round(rows.reduce(function (s, r) { return s + r.pct; }, 0) / rows.length);

  logAudit_('Student', 'student_profile', 'OK', roll);
  return ok_({
    roll: roll,
    name: roster.name || rows[rows.length - 1].name,
    section: roster.section || rows[rows.length - 1].section,
    cohortId: roster.cohortId || rows[rows.length - 1].cohortId || '',
    quizzesTaken: uniq_(rows.map(function (r) { return r.quiz; })).length,
    attemptsCount: rows.length,
    avgPct: avgPct,
    bestGrade: rows.slice().sort(function (a, b) { return b.pct - a.pct; })[0].grade,
    attempts: attempts, topics: topics,
    calibration: {
      itemsRated: calib.rated,
      avgConfidence: calib.rated ? Math.round(100 * calib.confSum / calib.rated / 3) : 0,
      overconfidentItems: calib.sureWrong,
      underconfidentItems: calib.unsureRight
    }
  });
}

function handleStudentsList_(p) {
  var required = String(getConfig_('api_key', '')).trim();
  if (required && String(p.key || '').trim() !== required) {
    logAudit_('Student', 'students', 'DENIED', '');
    return fail_('ERR-003', 'Invalid or missing key.');
  }
  var rows = readResponses_();
  if (!rows.length) return ok_([]);

  var map = {};
  rows.forEach(function (r) {
    if (!r.roll) return;
    if (!map[r.roll]) map[r.roll] = { roll: r.roll, name: r.name, section: r.section,
                                      attempts: 0, quizzes: {}, pctSum: 0, lastSeen: null };
    var m = map[r.roll];
    m.attempts++; m.quizzes[r.quiz] = true; m.pctSum += r.pct;
    m.name = r.name || m.name; m.section = r.section || m.section;
    if (r.ts && (!m.lastSeen || r.ts > m.lastSeen)) m.lastSeen = r.ts;
  });
  var list = Object.keys(map).map(function (k) {
    var m = map[k];
    return { roll: m.roll, name: m.name, section: m.section,
             quizzes: Object.keys(m.quizzes).length, attempts: m.attempts,
             avgPct: Math.round(m.pctSum / m.attempts),
             lastSeen: m.lastSeen ? m.lastSeen.toISOString() : '' };
  }).sort(function (a, b) { return b.avgPct - a.avgPct; });
  return ok_(list);
}

function lookupRoster_(roll) {
  var sh = ss_().getSheetByName(SGIF.SHEETS.STUDENTS);
  if (!sh || sh.getLastRow() <= 1) return {};
  var values = sh.getDataRange().getValues();
  var H = STUDENT_HEADERS_();
  var iRoll = H.indexOf('Roll Number');
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][iRoll]).trim().toUpperCase() === roll) {
      return {
        name: values[r][H.indexOf('Name')], section: values[r][H.indexOf('Section')],
        branch: values[r][H.indexOf('Branch')], semester: values[r][H.indexOf('Semester')],
        cohortId: values[r][H.indexOf('Cohort_ID')], status: values[r][H.indexOf('Status')]
      };
    }
  }
  return {};
}


/* ============ MODULE 3 — ACTIVITIES & REGISTRATION HANDLERS ============== */

/* ---- activities (public) ------------------------------------------------- */
function handleActivities_(p) {
  var acts = readActivities_();
  var regCounts = countActiveRegs_();
  var now = new Date();

  var visible = acts.filter(function (a) {
    return a.status === 'OPEN' || a.status === 'CLOSED' || a.status === 'DONE';
  }).map(function (a) {
    var used = regCounts[a.id] || 0;
    var seatsLeft = (a.capacity > 0) ? Math.max(0, a.capacity - used) : null;
    var windowOk = (!a.regStart || now >= a.regStart) && (!a.regEnd || now <= a.regEnd);
    return {
      id: a.id, title: a.title, type: a.type, description: a.description,
      venue: a.venue, date: a.date ? a.date.toISOString() : '',
      regStart: a.regStart ? a.regStart.toISOString() : '',
      regEnd: a.regEnd ? a.regEnd.toISOString() : '',
      capacity: a.capacity, registered: used, seatsLeft: seatsLeft,
      status: a.status, eligibility: a.eligibility, quizIds: a.quizIds,
      regOpen: (a.status === 'OPEN') && windowOk && (seatsLeft === null || seatsLeft > 0)
    };
  });
  return ok_(visible);
}

/* ---- register (GET performs the write; atomic via ScriptLock) ------------ */
/* v1.5: now stores Email, Phone, Course, Specialisation                      */
function handleRegister_(p) {
  var activityId     = String(p.activity      || '').trim();
  var roll           = String(p.roll          || '').trim().toUpperCase();
  var name           = String(p.name          || '').trim();
  var email          = String(p.email         || '').trim();          // NEW v1.5
  var phone          = String(p.phone         || '').trim();          // NEW v1.5
  var course         = String(p.course        || '').trim();          // NEW v1.5
  var specialisation = String(p.specialisation|| '').trim();          // NEW v1.5

  if (!activityId || !roll || !name)
    return fail_('ERR-001', 'activity, roll and name are required.');

  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
  } catch (e) {
    return fail_('ERR-009', 'Server busy — please try again in a few seconds.');
  }

  try {
    var act = readActivities_().filter(function (a) { return a.id === activityId; })[0];
    if (!act) return fail_('ERR-004', 'Activity not found.');
    if (act.status !== 'OPEN') return fail_('ERR-006', 'Registration is not open for this activity.');

    var now = new Date();
    if (act.regStart && now < act.regStart) return fail_('ERR-006', 'Registration has not started yet.');
    if (act.regEnd   && now > act.regEnd)   return fail_('ERR-006', 'Registration window has closed.');

    var regs = readRegistrations_();
    var dup = regs.some(function (r) {
      return r.activityId === activityId && r.roll === roll && r.status === 'Registered';
    });
    if (dup) return fail_('ERR-005', 'You are already registered for this activity.');

    if (act.capacity > 0) {
      var used = regs.filter(function (r) {
        return r.activityId === activityId && r.status === 'Registered';
      }).length;
      if (used >= act.capacity) return fail_('ERR-006', 'Sorry, this activity is full.');
    }

    var rid = 'REG-' + activityId + '-' + Date.now().toString(36).toUpperCase() +
              Math.floor(Math.random() * 1296).toString(36).toUpperCase();

    var sh = getSheet_(SGIF.SHEETS.REGISTRATIONS, REGISTRATION_HEADERS_());

    /* appendRow column order must match REGISTRATION_HEADERS_() exactly */
    sh.appendRow([
      new Date(),                   // Timestamp
      rid,                          // Registration_ID
      activityId,                   // Activity_ID
      roll,                         // Roll Number
      name,                         // Name
      safe_(p.section),             // Section
      safe_(p.branch),              // Branch
      email,                        // Email          ← NEW v1.5
      phone,                        // Phone          ← NEW v1.5
      course,                       // Course         ← NEW v1.5
      safe_(p.semester),            // Semester
      specialisation,               // Specialisation ← NEW v1.5
      'Registered',                 // Status
      ''                            // Cancelled On
    ]);

    var currentUsed = regs.filter(function (r) {
      return r.activityId === activityId && r.status === 'Registered';
    }).length;
    var seatsLeft = (act.capacity > 0) ? Math.max(0, act.capacity - (currentUsed + 1)) : null;

    logAudit_('Activity', 'register', 'OK', roll + ' / ' + activityId);
    return ok_({
      registered: true, registrationId: rid, activity: act.title,
      seatsLeft: seatsLeft,
      note: 'Save your Registration ID — you need it to cancel.'
    });
  } finally {
    lock.releaseLock();
  }
}

/* ---- my_registrations ---------------------------------------------------- */
/* v1.5: returns email, phone, course, specialisation for each registration   */
function handleMyRegistrations_(p) {
  var roll = String(p.roll || '').trim().toUpperCase();
  if (!roll) return fail_('ERR-001', 'roll is required.');

  var actsById = {};
  readActivities_().forEach(function (a) { actsById[a.id] = a; });

  var list = readRegistrations_()
    .filter(function (r) { return r.roll === roll; })
    .map(function (r) {
      var a = actsById[r.activityId] || {};
      return {
        registrationId: r.rid,
        activityId:     r.activityId,
        title:          a.title  || r.activityId,
        type:           a.type   || '',
        date:           a.date   ? a.date.toISOString() : '',
        venue:          a.venue  || '',
        status:         r.status,
        registeredOn:   r.ts     ? r.ts.toISOString() : '',
        /* NEW v1.5 — useful for passport.html pre-fill */
        email:          r.email,
        phone:          r.phone,
        course:         r.course,
        specialisation: r.specialisation
      };
    })
    .sort(function (a, b) { return (b.registeredOn > a.registeredOn) ? 1 : -1; });
  return ok_(list);
}

/* ---- cancel_registration ------------------------------------------------- */
function handleCancelRegistration_(p) {
  var roll = String(p.roll || '').trim().toUpperCase();
  var rid  = String(p.rid  || '').trim().toUpperCase();
  if (!roll || !rid) return fail_('ERR-001', 'roll and rid are required.');

  var sh = ss_().getSheetByName(SGIF.SHEETS.REGISTRATIONS);
  if (!sh || sh.getLastRow() <= 1) return fail_('ERR-004', 'Registration not found.');

  var values = sh.getDataRange().getValues();
  var H = REGISTRATION_HEADERS_();
  var iRid       = H.indexOf('Registration_ID');
  var iRoll      = H.indexOf('Roll Number');
  var iStatus    = H.indexOf('Status');
  var iCancelled = H.indexOf('Cancelled On');

  for (var r = 1; r < values.length; r++) {
    if (String(values[r][iRid]).trim().toUpperCase() === rid) {
      if (String(values[r][iRoll]).trim().toUpperCase() !== roll) {
        logAudit_('Activity', 'cancel_registration', 'DENIED', roll + ' / ' + rid);
        return fail_('ERR-003', 'That Registration ID does not belong to this roll number.');
      }
      if (String(values[r][iStatus]) !== 'Registered')
        return fail_('ERR-006', 'This registration is already cancelled.');
      sh.getRange(r + 1, iStatus    + 1).setValue('Cancelled');
      sh.getRange(r + 1, iCancelled + 1).setValue(new Date());
      logAudit_('Activity', 'cancel_registration', 'OK', roll + ' / ' + rid);
      return ok_({ cancelled: true });
    }
  }
  return fail_('ERR-004', 'Registration not found.');
}

/* ---- participants (api_key gated) ---------------------------------------- */
/* v1.5: returns email, phone, course, specialisation per participant          */
function handleParticipants_(p) {
  var required = String(getConfig_('api_key', '')).trim();
  if (required && String(p.key || '').trim() !== required) {
    logAudit_('Activity', 'participants', 'DENIED', '');
    return fail_('ERR-003', 'Invalid or missing key.');
  }
  var activityId = String(p.activity || '').trim();
  if (!activityId) return fail_('ERR-001', 'activity is required.');

  var list = readRegistrations_()
    .filter(function (r) { return r.activityId === activityId; })
    .map(function (r) {
      return {
        registrationId: r.rid,
        roll:           r.roll,
        name:           r.name,
        section:        r.section,
        branch:         r.branch,
        email:          r.email,          // NEW v1.5
        phone:          r.phone,          // NEW v1.5
        course:         r.course,         // NEW v1.5
        semester:       r.semester,
        specialisation: r.specialisation, // NEW v1.5
        status:         r.status,
        registeredOn:   r.ts ? r.ts.toISOString() : ''
      };
    });
  return ok_(list);
}


/* ==================== SHARED READERS ==================================== */

function readResponses_() {
  var sh = ss_().getSheetByName(SGIF.SHEETS.RESPONSES);
  if (!sh || sh.getLastRow() <= 1) return [];
  var values = sh.getDataRange().getValues();
  var H = RESPONSE_HEADERS_();
  var i = function (n) { return H.indexOf(n); };
  var out = [];
  for (var r = 1; r < values.length; r++) {
    var row = values[r];
    out.push({
      ts: (row[i('Timestamp')] instanceof Date) ? row[i('Timestamp')] : null,
      submissionId: String(row[i('Submission ID')] || ''),
      sessionId: String(row[i('Session_ID')] || ''),
      quiz: String(row[i('Quiz_ID')] || '').trim(),
      cohortId: String(row[i('Cohort_ID')] || ''),
      name: row[i('Name')],
      roll: String(row[i('Roll Number')] || '').trim().toUpperCase(),
      section: row[i('Section')], mode: row[i('Mode')],
      score: Number(row[i('Score Raw')]) || 0,
      total: Number(row[i('Total')]) || 0,
      pct: Number(row[i('Percentage')]) || 0,
      grade: row[i('Grade')],
      tagsJson: row[i('Tags (JSON)')],
      confJson: row[i('Confidence (JSON)')],
      correctJson: row[i('Correct (JSON)')]
    });
  }
  return out;
}

function readActivities_() {
  var sh = ss_().getSheetByName(SGIF.SHEETS.ACTIVITIES);
  if (!sh || sh.getLastRow() <= 1) return [];
  var values = sh.getDataRange().getValues();
  var H = ACTIVITY_HEADERS_();
  var i = function (n) { return H.indexOf(n); };
  var out = [];
  for (var r = 1; r < values.length; r++) {
    var row = values[r];
    var id = String(row[i('Activity_ID')] || '').trim();
    if (!id) continue;
    out.push({
      id: id,
      title: String(row[i('Title')] || ''),
      type: String(row[i('Type')] || ''),
      description: String(row[i('Description')] || ''),
      venue: String(row[i('Venue')] || ''),
      date: (row[i('Activity Date')] instanceof Date) ? row[i('Activity Date')] : null,
      regStart: (row[i('Reg Start')] instanceof Date) ? row[i('Reg Start')] : null,
      regEnd: (row[i('Reg End')] instanceof Date) ? row[i('Reg End')] : null,
      capacity: Number(row[i('Capacity')]) || 0,
      status: String(row[i('Status')] || '').trim().toUpperCase(),
      eligibility: String(row[i('Eligibility')] || ''),
      quizIds: String(row[i('Quiz_IDs')] || '').split(',')
                 .map(function (s) { return s.trim(); }).filter(String),
      cohortId: String(row[i('Cohort_ID')] || '')
    });
  }
  return out;
}

/* v1.5: reads all 14 columns including new fields */
function readRegistrations_() {
  var sh = ss_().getSheetByName(SGIF.SHEETS.REGISTRATIONS);
  if (!sh || sh.getLastRow() <= 1) return [];
  var values = sh.getDataRange().getValues();
  var H = REGISTRATION_HEADERS_();
  var i = function (n) { return H.indexOf(n); };
  var out = [];
  for (var r = 1; r < values.length; r++) {
    var row = values[r];
    out.push({
      ts:             (row[i('Timestamp')] instanceof Date) ? row[i('Timestamp')] : null,
      rid:            String(row[i('Registration_ID')] || ''),
      activityId:     String(row[i('Activity_ID')]    || '').trim(),
      roll:           String(row[i('Roll Number')]    || '').trim().toUpperCase(),
      name:           row[i('Name')],
      section:        row[i('Section')],
      branch:         row[i('Branch')],
      email:          String(row[i('Email')]          || ''),   // NEW v1.5
      phone:          String(row[i('Phone')]          || ''),   // NEW v1.5
      course:         String(row[i('Course')]         || ''),   // NEW v1.5
      semester:       row[i('Semester')],
      specialisation: String(row[i('Specialisation')] || ''),  // NEW v1.5
      status:         String(row[i('Status')]         || '')
    });
  }
  return out;
}

function countActiveRegs_() {
  var counts = {};
  readRegistrations_().forEach(function (r) {
    if (r.status !== 'Registered') return;
    counts[r.activityId] = (counts[r.activityId] || 0) + 1;
  });
  return counts;
}


/* ==================== CONFIG / AUDIT / HELPERS =========================== */

function getAllConfig_() {
  var sh = getSheet_(SGIF.SHEETS.CONFIG, ['Key', 'Value', 'Description', 'UpdatedOn']);
  if (sh.getLastRow() <= 1) return {};
  var values = sh.getDataRange().getValues();
  var out = {};
  for (var r = 1; r < values.length; r++) {
    var key = String(values[r][0]).trim();
    if (key && key !== 'api_key') out[key] = values[r][1];
  }
  return out;
}

function getConfig_(key, fallback) {
  var sh = ss_().getSheetByName(SGIF.SHEETS.CONFIG);
  if (!sh || sh.getLastRow() <= 1) return fallback;
  var values = sh.getDataRange().getValues();
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][0]).trim() === key) return values[r][1];
  }
  return fallback;
}

function logAudit_(module, action, status, remarks) {
  try {
    var sh = getSheet_(SGIF.SHEETS.AUDIT, ['Timestamp', 'Module', 'Action', 'Status', 'Remarks']);
    sh.appendRow([new Date(), module, action, status, remarks || '']);
  } catch (ignore) {}
}

function ss_() { return SpreadsheetApp.getActiveSpreadsheet(); }

function getSheet_(name, headers) {
  var ss = ss_();
  var sh = ss.getSheetByName(name);
  if (!sh) sh = ss.insertSheet(name);
  if (sh.getLastRow() === 0 && headers && headers.length) {
    sh.appendRow(headers);
    sh.getRange(1, 1, 1, headers.length)
      .setBackground('#2563eb').setFontColor('#ffffff').setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

function ok_(data)  { return json_({ success: true,  message: 'OK', data: data, errors: [], meta: meta_() }); }
function fail_(code, message) {
  return json_({ success: false, message: message, data: null,
                 errors: [{ code: code, message: message }], meta: meta_() });
}
function meta_() { return { timestamp: new Date().toISOString(), version: SGIF.VERSION }; }
function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function safe_(v)  { return (v === undefined || v === null) ? '' : v; }
function numOr_(v, dflt) { var n = Number(v); return isNaN(n) ? dflt : n; }
function uniq_(arr) {
  var seen = {}; var out = [];
  arr.forEach(function (x) { if (!seen[x]) { seen[x] = 1; out.push(x); } });
  return out;
}
function parseArr_(s) {
  try { var a = JSON.parse(s); return Array.isArray(a) ? a : []; } catch (e) { return []; }
}
function firstNonEmpty_(a, b) {
  if (a && a.length) return a;
  if (b && b.length) return b;
  return [];
}
function collectIndexed_(obj, prefix) {
  var pairs = [];
  Object.keys(obj).forEach(function (k) {
    if (k.indexOf(prefix) === 0) {
      var n = parseInt(k.slice(prefix.length), 10);
      if (!isNaN(n)) pairs.push([n, obj[k]]);
    }
  });
  pairs.sort(function (a, b) { return a[0] - b[0]; });
  return pairs.map(function (p) { return p[1]; });
}


