/* ==================== ONE-TIME SETUP ===================================== */
function setup() {
  getSheet_(SGIF.SHEETS.CONFIG,        ['Key', 'Value', 'Description', 'UpdatedOn']);
  getSheet_(SGIF.SHEETS.AUDIT,         ['Timestamp', 'Module', 'Action', 'Status', 'Remarks']);
  getSheet_(SGIF.SHEETS.RESPONSES,     RESPONSE_HEADERS_());
  getSheet_(SGIF.SHEETS.EVENTS,        EVENT_HEADERS_());
  getSheet_(SGIF.SHEETS.STUDENTS,      STUDENT_HEADERS_());
  getSheet_(SGIF.SHEETS.ACTIVITIES,    ACTIVITY_HEADERS_());
  getSheet_(SGIF.SHEETS.REGISTRATIONS, REGISTRATION_HEADERS_());

  var cfg = ss_().getSheetByName(SGIF.SHEETS.CONFIG);
  if (cfg.getLastRow() <= 1) {
    cfg.appendRow(['institution',             'SGT University',  'Shown in page headers',                    new Date()]);
    cfg.appendRow(['faculty_name',            'K.P. Singh',      'Faculty owner',                            new Date()]);
    cfg.appendRow(['default_leaderboard_size','5',               'Top-N students',                           new Date()]);
    cfg.appendRow(['api_key',                 '',                'SET THIS: gates students & participants',  new Date()]);
  }
  logAudit_('Foundation', 'setup', 'OK', 'Tabs verified (v' + SGIF.VERSION + ')');
  return 'SGIF setup complete (v' + SGIF.VERSION + '). ' +
         'Registrations tab now has 14 columns including Email, Phone, Course, Specialisation.';
}
